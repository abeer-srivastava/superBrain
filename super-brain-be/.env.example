# ─────────────────────────────────────────────────────────────────────
# SuperBrain Backend Environment Variables
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────

# MongoDB
# Local:   mongodb://127.0.0.1:27017/superbrain
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/superbrain
MONGO_URL=mongodb://127.0.0.1:27017/superbrain

# Redis (BullMQ queue)
# Local: leave REDIS_URL blank and use HOST/PORT below
# Upstash: set REDIS_URL=redis://default:<pass>@<host>:6379
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Qdrant Vector DB
# Local:  QDRANT_URL=http://127.0.0.1:6333
# Cloud:  QDRANT_URL=https://<cluster>.aws.cloud.qdrant.io
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# JWT
JWT_SECRET=change-this-to-a-long-random-secret

# Google Gemini API (LLM for summarization and Q&A)
GEMINI_API_KEY=your-gemini-api-key

# Server port (default 3000)
PORT=3000

# CORS — comma-separated origins allowed in production
# Leave blank to allow all origins (dev only)
# Example: ALLOWED_ORIGINS=https://superbrain.yourdomain.com
ALLOWED_ORIGINS=
